---
import { NAV } from '../../lib/site';
import Logo from './Logo.astro';

interface Props {
  mode?: 'transparent' | 'solid';
}
const { mode = 'transparent' } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href.startsWith('/#') ? false : href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="nav" data-mode={mode} data-nav>
  <div class="nav-inner">
    <a class="nav-brand" href="/" aria-label="MeCorder home">
      <Logo />
      <span>MeCorder</span>
    </a>

    <nav class="nav-links" aria-label="Main">
      <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
      {
        NAV.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-actions">
      <button class="nav-search" type="button" data-open-search aria-label="Search documentation" title="Search docs (⌘K)">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.6"></circle><path d="m13.2 13.2 3.3 3.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
      <a class="btn btn-sm btn-primary nav-download" href="/download" data-track="download_click" data-track-from="nav">
        Download
      </a>
      <button class="nav-menu-btn" type="button" aria-expanded="false" aria-controls="nav-sheet" data-nav-toggle>
        <span class="sr-only">Menu</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="nav-sheet" id="nav-sheet" data-nav-sheet hidden>
    <nav aria-label="Mobile">
      {
        NAV.map((item, i) => (
          <a href={item.href} style={`--i:${i}`} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href="/download" style={`--i:${NAV.length}`} class="sheet-download">Download for macOS</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--nav-h);
    transition:
      background-color var(--t-panel) ease,
      backdrop-filter var(--t-panel) ease,
      box-shadow var(--t-panel) ease,
      height var(--t-panel) var(--ease-out);
  }
  .nav[data-mode='transparent']:not(.is-compact) {
    height: 76px;
  }
  .nav.is-compact,
  .nav[data-mode='solid'] {
    background: rgba(14, 14, 16, 0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 1px 0 var(--border-subtle);
  }
  .nav-inner {
    height: 100%;
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    letter-spacing: -0.01em;
    font-size: 1.02rem;
    justify-self: start;
  }
  .nav-links {
    position: relative;
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
  }
  .nav-link {
    position: relative;
    z-index: 1;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.88rem;
    color: var(--text-2);
    transition: color var(--t-hover) ease;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }
  .nav-indicator {
    position: absolute;
    top: 4px;
    left: 0;
    height: calc(100% - 8px);
    width: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    opacity: 0;
    transition:
      transform 360ms var(--ease-spring),
      width 360ms var(--ease-spring),
      opacity var(--t-select) ease;
    pointer-events: none;
  }
  .nav-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-search {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 0;
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    transition: background-color var(--t-hover) ease, color var(--t-hover) ease;
  }
  .nav-search:hover {
    background: rgba(255, 255, 255, 0.07);
    color: var(--text);
  }
  .nav-search svg {
    width: 18px;
    height: 18px;
  }
  .nav-menu-btn {
    display: none;
    width: 38px;
    height: 38px;
    border: 0;
    background: transparent;
    cursor: pointer;
    border-radius: 50%;
  }
  .bars {
    display: grid;
    gap: 6px;
    width: 18px;
    margin: auto;
  }
  .bars i {
    display: block;
    height: 1.5px;
    background: var(--text);
    border-radius: 2px;
    transition: transform var(--t-panel) var(--ease-out);
  }
  .nav.menu-open .bars i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .nav.menu-open .bars i:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }
  .nav-sheet {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    background: rgba(11, 11, 12, 0.96);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 24px var(--gutter);
  }
  .nav-sheet nav {
    display: grid;
    gap: 4px;
  }
  .nav-sheet a {
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-subtle);
    opacity: 0;
    transform: translateY(-8px);
    animation: sheet-in 420ms var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 40ms);
  }
  .nav-sheet .sheet-download {
    color: var(--accent-hover);
    border-bottom: 0;
  }
  @keyframes sheet-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 860px) {
    .nav-inner {
      grid-template-columns: 1fr auto;
    }
    .nav-links {
      display: none;
    }
    .nav-menu-btn {
      display: block;
    }
    .nav[data-mode='transparent']:not(.is-compact) {
      height: var(--nav-h);
    }
    .nav.menu-open {
      background: rgba(11, 11, 12, 0.96);
    }
  }
  @media (max-width: 420px) {
    .nav-download {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    // Large transparent bar at the top, compact blurred bar once the page moves.
    let compact = false;
    const update = () => {
      const next = window.scrollY > 24;
      if (next !== compact) {
        compact = next;
        nav.classList.toggle('is-compact', compact);
      }
    };
    update();
    window.addEventListener('scroll', update, { passive: true });

    // A single pill slides under whichever link is hovered or active.
    const links = nav.querySelector<HTMLElement>('.nav-links');
    const indicator = nav.querySelector<HTMLElement>('[data-nav-indicator]');
    if (links && indicator) {
      const moveTo = (el: HTMLElement | null) => {
        if (!el) {
          indicator.style.opacity = '0';
          return;
        }
        indicator.style.opacity = '1';
        indicator.style.width = `${el.offsetWidth}px`;
        indicator.style.transform = `translateX(${el.offsetLeft}px)`;
      };
      const active = () => links.querySelector<HTMLElement>('.nav-link.active');
      moveTo(active());
      links.querySelectorAll<HTMLElement>('.nav-link').forEach((a) => {
        a.addEventListener('pointerenter', () => moveTo(a));
        a.addEventListener('focus', () => moveTo(a));
      });
      links.addEventListener('pointerleave', () => moveTo(active()));
    }

    // Mobile sheet.
    const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const sheet = nav.querySelector<HTMLElement>('[data-nav-sheet]');
    const setOpen = (open: boolean) => {
      if (!toggle || !sheet) return;
      toggle.setAttribute('aria-expanded', String(open));
      sheet.hidden = !open;
      nav.classList.toggle('menu-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    sheet?.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('menu-open')) setOpen(false);
    });
  }
</script>
