---
/**
 * Documentation search: ⌘K or / anywhere. A static JSON index (built from the
 * Markdown, one entry per section) is fetched the first time the dialog opens.
 * Titles and body text are searched; matches are highlighted.
 */
---

<dialog class="search" data-search aria-label="Search documentation">
  <div class="search-panel">
    <div class="search-field">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.6"></circle><path d="m13.2 13.2 3.3 3.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      <input
        type="search"
        placeholder="Search the documentation"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
        data-search-input
      />
      <kbd>esc</kbd>
    </div>
    <ul class="search-results" id="search-results" role="listbox" data-search-results></ul>
    <div class="search-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> to move</span>
      <span><kbd>↵</kbd> to open</span>
      <span><kbd>⌘K</kbd> or <kbd>/</kbd> to search</span>
    </div>
  </div>
</dialog>

<style>
  .search {
    width: min(640px, calc(100vw - 32px));
    max-height: min(72vh, 620px);
    margin: 12vh auto auto;
    padding: 0;
    border: 0;
    border-radius: 16px;
    background: rgba(28, 28, 30, 0.92);
    color: var(--text);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8), 0 0 0 1px var(--border);
    backdrop-filter: blur(30px) saturate(160%);
    -webkit-backdrop-filter: blur(30px) saturate(160%);
    overflow: hidden;
  }
  .search[open] {
    animation: s-in 260ms var(--ease-out);
  }
  .search::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }
  @keyframes s-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }
  .search-panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .search-field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .search-field svg {
    width: 18px;
    color: var(--text-3);
    flex: none;
  }
  .search-field input {
    flex: 1;
    height: 56px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.05rem;
  }
  .search-field input::-webkit-search-cancel-button {
    display: none;
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
    flex: 1;
  }
  .search-results :global(li a) {
    display: block;
    padding: 10px 12px;
    border-radius: 10px;
  }
  .search-results :global(li[aria-selected='true'] a) {
    background: var(--accent-soft);
    box-shadow: 0 0 0 1px rgba(139, 124, 255, 0.3) inset;
  }
  .search-results :global(.sr-t) {
    font-weight: 600;
    display: block;
  }
  .search-results :global(.sr-p) {
    font-size: 12px;
    color: var(--text-3);
    margin-left: 6px;
    font-weight: 400;
  }
  .search-results :global(.sr-x) {
    display: block;
    margin-top: 3px;
    font-size: 13px;
    color: var(--text-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-results :global(mark) {
    background: rgba(139, 124, 255, 0.28);
    color: var(--text);
    border-radius: 3px;
    padding: 0 1px;
  }
  .search-results :global(.sr-empty) {
    padding: 28px 12px;
    text-align: center;
    color: var(--text-3);
    font-size: 14px;
  }
  .search-foot {
    display: flex;
    gap: 18px;
    padding: 10px 16px;
    border-top: 1px solid var(--border-subtle);
    font-size: 12px;
    color: var(--text-4);
  }
  .search-foot kbd {
    font-size: 11px;
    margin-right: 3px;
  }
  @media (max-width: 560px) {
    .search {
      margin-top: 8px;
      max-height: 86vh;
    }
    .search-foot {
      display: none;
    }
  }
</style>

<script>
  import { track } from '../../lib/analytics';
  import { u } from '../../lib/url';

  type Entry = { t: string; p: string; u: string; x: string };
  const dialog = document.querySelector<HTMLDialogElement>('[data-search]');
  if (dialog) {
    const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
    const list = dialog.querySelector<HTMLUListElement>('[data-search-results]')!;
    let index: Entry[] | null = null;
    let results: Entry[] = [];
    let sel = 0;
    let lastQuery = '';

    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const terms = (q: string) => q.toLowerCase().split(/\s+/).filter(Boolean);
    const mark = (s: string, ts: string[]) => {
      let out = esc(s);
      for (const t of ts) {
        const re = new RegExp(`(${t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
        out = out.replace(re, '<mark>$1</mark>');
      }
      return out;
    };
    const snippet = (x: string, ts: string[]) => {
      const lx = x.toLowerCase();
      const at = Math.min(...ts.map((t) => lx.indexOf(t)).filter((i) => i >= 0), Infinity);
      if (!isFinite(at)) return x.slice(0, 120);
      const start = Math.max(0, at - 40);
      return (start ? '…' : '') + x.slice(start, start + 140);
    };

    function search(q: string) {
      const ts = terms(q);
      if (!index) return;
      if (!ts.length) {
        results = index.filter((e) => e.p === 'Docs').slice(0, 8);
      } else {
        results = index
          .map((e) => {
            const lt = e.t.toLowerCase();
            const lx = e.x.toLowerCase();
            let score = 0;
            for (const t of ts) {
              if (lt.startsWith(t)) score += 12;
              else if (lt.includes(t)) score += 8;
              else if (lx.includes(t)) score += 2 + Math.min(3, lx.split(t).length - 1) * 0.5;
              else return { e, score: -1 };
            }
            return { e, score };
          })
          .filter((r) => r.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 12)
          .map((r) => r.e);
      }
      sel = 0;
      list.innerHTML = results.length
        ? results
            .map(
              (r, i) =>
                `<li role="option" id="sr-${i}" aria-selected="${i === 0}"><a href="${r.u}"><span class="sr-t">${mark(r.t, ts)}<span class="sr-p">${esc(r.p)}</span></span><span class="sr-x">${mark(snippet(r.x, ts), ts)}</span></a></li>`,
            )
            .join('')
        : `<li class="sr-empty">No results for “${esc(q)}”</li>`;
      input.setAttribute('aria-activedescendant', results.length ? 'sr-0' : '');
    }

    function move(d: number) {
      if (!results.length) return;
      sel = (sel + d + results.length) % results.length;
      list.querySelectorAll('li[role=option]').forEach((li, i) => li.setAttribute('aria-selected', String(i === sel)));
      input.setAttribute('aria-activedescendant', `sr-${sel}`);
      list.querySelector(`#sr-${sel}`)?.scrollIntoView({ block: 'nearest' });
    }

    async function open() {
      if (dialog!.open) return;
      dialog!.showModal();
      input.value = '';
      input.focus();
      if (!index) {
        list.innerHTML = '<li class="sr-empty">Loading…</li>';
        try {
          index = await (await fetch(u('/search-index.json'))).json();
        } catch {
          list.innerHTML = '<li class="sr-empty">Search is unavailable offline.</li>';
          return;
        }
      }
      search('');
    }

    input.addEventListener('input', () => search(input.value));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') (e.preventDefault(), move(1));
      else if (e.key === 'ArrowUp') (e.preventDefault(), move(-1));
      else if (e.key === 'Enter' && results[sel]) {
        e.preventDefault();
        if (input.value.trim() && input.value !== lastQuery) track('docs_search', { q: input.value.trim().slice(0, 40) });
        lastQuery = input.value;
        location.href = results[sel].u;
        dialog!.close();
      }
    });
    list.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) dialog!.close();
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    document.addEventListener('keydown', (e) => {
      const typing = (e.target as HTMLElement)?.closest?.('input, textarea, select, [contenteditable]');
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        open();
      } else if (e.key === '/' && !typing && !dialog.open) {
        e.preventDefault();
        open();
      }
    });
    document.querySelectorAll('[data-open-search]').forEach((b) => b.addEventListener('click', open));
  }
</script>
