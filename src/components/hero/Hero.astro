---
import { u } from '../../lib/url';
/**
 * HERO — a short product film: a cursor, a window that materialises in space,
 * a recording, the click being understood as a named target, a Program
 * assembling itself, the camera responding, and the finished video.
 * Choreography is data (lib/animation/timeline.ts tracks) evaluated as a pure
 * function of time in hero.ts; the camera move comes from the real executor.
 */
import MockApp from '../demos/MockApp.astro';
import { programHTML } from '../../lib/program/blocks';
import { PRIMARY_BUTTON_PROGRAM } from '../../lib/program/model';
import { SITE } from '../../lib/site';

const steps = ['Record', 'Understand', 'Program', 'Finished video'];
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-glow" data-depth="0.12"></div>
    <div class="hero-grid" data-depth="0.25"></div>
    <div class="hero-orbit" data-depth="0.4"></div>
  </div>

  <div class="hero-copy" data-hero-copy>
    <p class="eyebrow hero-eyebrow"><span class="chip chip-preview">In development · macOS</span></p>
    <h1 id="hero-title" class="hero-title">
      <span class="ht-line">Program your</span>
      <span class="ht-line">screen videos.</span>
    </h1>
    <p class="lead hero-sub">Don't edit every frame. Record once, then tell the video how to behave when something happens inside it.</p>
    <div class="hero-ctas">
      <a href={u('/download')} class="btn btn-primary btn-lg" data-track="download_click" data-track-from="hero" data-magnetic>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M14.1 10.6c0-2 1.6-2.9 1.7-3a3.7 3.7 0 0 0-2.9-1.6c-1.2-.1-2.4.7-3 .7s-1.6-.7-2.6-.7a3.9 3.9 0 0 0-3.3 2c-1.4 2.4-.4 6 1 8 .7 1 1.5 2 2.5 2s1.4-.6 2.6-.6 1.5.6 2.6.6 1.7-1 2.4-2a8 8 0 0 0 1.1-2.2 3.4 3.4 0 0 1-2.1-3.2zM12.2 4.6A3.4 3.4 0 0 0 13 2a3.5 3.5 0 0 0-2.3 1.2 3.2 3.2 0 0 0-.8 2.4 2.9 2.9 0 0 0 2.3-1z"></path></svg>
        Download for macOS
      </a>
      <a href="#program" class="btn btn-ghost btn-lg">Try the Program demo</a>
    </div>
    <p class="hero-req">{SITE.requirements}</p>
  </div>

  <div class="hero-stage-wrap">
    <div class="hero-stage" data-hero-stage>
      <div class="hero-intro-cursor" data-intro-cursor aria-hidden="true">
        <svg viewBox="0 0 28 28" width="34" height="34"><path d="M6 3.5v18.2l4.6-4.4 2.9 6.6 3.1-1.4-2.9-6.5h6.3z" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round"></path></svg>
      </div>

      <div class="hero-wallpaper" data-wallpaper aria-hidden="true"></div>

      <div class="hero-window" data-hero-window>
        <div class="hw-chrome" data-chrome>
          <span class="tl"><i></i><i></i><i></i></span>
          <span class="hw-title">MeCorder</span>
          <span class="hw-rec" data-rec><i></i><b data-rec-time>00:00</b></span>
        </div>
        <MockApp labels class="hero-screen" label="A recording of a project app. The click on Create Project is recognised as a Primary Button, a Program reacts to it, and the camera focuses and highlights the button." />
        <div class="hw-timeline" data-hero-timeline aria-hidden="true"></div>
      </div>

      <div class="hero-program" data-hero-program aria-hidden="true">
        <div class="hp-head">
          <span class="hp-title">Program</span>
          <span class="hp-state" data-hp-state>Editing</span>
        </div>
        <Fragment set:html={programHTML(PRIMARY_BUTTON_PROGRAM)} />
      </div>
    </div>

    <ol class="hero-steps" data-hero-steps aria-label="What you're watching">
      {steps.map((s, i) => <li data-step={i}><span>{s}</span></li>)}
    </ol>
    <button class="hero-replay" type="button" data-hero-replay aria-label="Replay the film">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10a6 6 0 1 0 1.8-4.3M4 3.5v3h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      Replay
    </button>
  </div>
</section>

<style>
  .hero {
    --stage-w: min(1040px, 86vw, max(560px, calc(160svh - 520px)));
    position: relative;
    min-height: max(100svh, 780px);
    overflow-x: clip;
    isolation: isolate;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero-bg > * {
    position: absolute;
    translate: var(--px, 0) var(--py, 0);
  }
  .hero-glow {
    left: 50%;
    top: 58%;
    width: 1400px;
    height: 900px;
    margin: -450px 0 0 -700px;
    background:
      radial-gradient(closest-side, rgba(139, 124, 255, 0.18), transparent 70%),
      radial-gradient(closest-side at 70% 60%, rgba(55, 108, 200, 0.12), transparent 70%);
    opacity: var(--glow, 0);
    filter: blur(10px);
  }
  .hero-grid {
    inset: -10% -10% auto;
    height: 120%;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 60% 50% at 50% 55%, #000 10%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 55%, #000 10%, transparent 75%);
    opacity: calc(var(--glow, 0) * 0.9);
    transform: perspective(900px) rotateX(58deg) translateY(10%);
    transform-origin: 50% 70%;
  }
  .hero-orbit {
    left: 50%;
    top: 56%;
    width: 1100px;
    height: 1100px;
    margin: -550px 0 0 -550px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.04);
    box-shadow: 0 0 0 140px rgba(255, 255, 255, 0.012), 0 0 0 280px rgba(255, 255, 255, 0.008);
    opacity: var(--glow, 0);
  }

  /* Copy sits on top; it appears at the end of the film. */
  .hero-copy {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--nav-h) + clamp(28px, 6vh, 72px));
    z-index: 3;
    text-align: center;
    padding: 0 var(--gutter);
    pointer-events: none;
  }
  .hero-copy.is-live {
    pointer-events: auto;
  }
  .hero-copy > * {
    opacity: var(--o, 0);
    transform: translateY(calc((1 - var(--o, 0)) * 18px));
  }
  .hero-title {
    font-size: var(--fs-hero);
    letter-spacing: -0.04em;
    line-height: 1;
    font-weight: 650;
  }
  .ht-line {
    display: block;
    background: linear-gradient(180deg, #fff 30%, rgba(255, 255, 255, 0.66));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.06em;
  }
  .hero-eyebrow {
    margin-bottom: 18px;
  }
  .hero-sub {
    max-width: 560px;
    margin: 18px auto 0;
  }
  .hero-ctas {
    margin-top: 28px;
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .hero-req {
    margin-top: 14px;
    font-size: var(--fs-micro);
    color: var(--text-4);
  }

  /* Stage */
  .hero-stage-wrap {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--stage-w);
    transform: translate(-50%, -50%) translate3d(0, var(--stage-y, 0px), 0) scale(var(--stage-s, 1));
    transform-origin: 50% 0%;
    z-index: 2;
  }
  .hero-stage {
    position: relative;
    perspective: 1800px;
    perspective-origin: 50% 40%;
  }
  .hero-intro-cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    opacity: 0;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.6));
    will-change: transform, opacity;
  }
  .hero-wallpaper {
    position: absolute;
    inset: -5.5% -4.5%;
    border-radius: 22px;
    background:
      radial-gradient(120% 90% at 0% 0%, #6d5ce8 0%, transparent 55%),
      radial-gradient(100% 80% at 100% 100%, #c2559b 0%, transparent 55%),
      linear-gradient(135deg, #3b2f9e, #2a1f63 60%, #4a2366);
    opacity: 0;
    transform: scale(0.94);
    box-shadow: 0 50px 100px -30px rgba(0, 0, 0, 0.8);
  }
  .hero-window {
    position: relative;
    border-radius: var(--r-window);
    background: #1a1a1c;
    box-shadow: var(--shadow-window);
    overflow: hidden;
    transform-style: preserve-3d;
    will-change: transform, opacity, filter;
    opacity: 0;
  }
  .hw-chrome {
    position: relative;
    display: flex;
    align-items: center;
    height: 38px;
    padding: 0 14px;
    background: #232325;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 13px;
    color: var(--text-3);
    transition: height 600ms var(--ease-out), opacity 400ms ease;
  }
  .hero-window.is-final .hw-chrome,
  .hero-window.is-final .hw-timeline {
    height: 0;
    opacity: 0;
    padding-block: 0;
    border: 0;
  }
  .tl {
    display: flex;
    gap: 8px;
  }
  .tl i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .tl i:nth-child(2) {
    background: #febc2e;
  }
  .tl i:nth-child(3) {
    background: #28c840;
  }
  .hw-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-weight: 600;
    color: var(--text-2);
  }
  .hw-rec {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-2);
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .hw-rec.is-on {
    opacity: 1;
  }
  .hw-rec i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--record);
    box-shadow: 0 0 10px var(--record);
    animation: rec-blink 1.2s steps(2, jump-none) infinite;
  }
  @keyframes rec-blink {
    50% {
      opacity: 0.35;
    }
  }
  .hw-timeline {
    height: 84px;
    background: #161617;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
    transition: height 600ms var(--ease-out), opacity 400ms ease;
  }

  /* Progressive UI reveal inside the recording */
  .hero-screen :global(.side),
  .hero-screen :global(.search),
  .hero-screen :global(.avatar),
  .hero-screen :global(.create-btn),
  .hero-screen :global(.page-title),
  .hero-screen :global(.page-sub),
  .hero-screen :global(.card:not(.card-new)) {
    transition:
      opacity 600ms var(--ease-out),
      translate 700ms var(--ease-out);
  }
  .hero-window:not(.ui-1) .hero-screen :global(.side) {
    opacity: 0;
    translate: -30px 0;
  }
  .hero-window:not(.ui-2) .hero-screen :global(:is(.search, .avatar, .create-btn)) {
    opacity: 0;
    translate: 0 -14px;
  }
  .hero-window:not(.ui-3) .hero-screen :global(:is(.page-title, .page-sub, .card:not(.card-new))) {
    opacity: 0;
    translate: 0 20px;
  }
  .hero-screen :global(.card:nth-child(n)) {
    transition-delay: calc(var(--i, 0) * 60ms);
  }

  /* Program panel floating in front, at its own depth */
  .hero-program {
    position: absolute;
    right: -6%;
    top: 36%;
    z-index: 4;
    padding: 14px 18px 22px;
    border-radius: var(--r-prominent);
    background: rgba(28, 28, 30, 0.82);
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    box-shadow: var(--shadow-float);
    opacity: 0;
    will-change: transform, opacity;
  }
  .hp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 12px;
    font-size: 12px;
  }
  .hp-title {
    font-weight: 600;
    color: var(--text-2);
  }
  .hp-state {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .hp-state.is-running {
    color: var(--accent-hover);
  }

  .hero-steps {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-4);
    opacity: var(--steps-o, 0);
  }
  .hero-steps li {
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 300ms ease;
  }
  .hero-steps li + li::before {
    content: '';
    width: 22px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
  .hero-steps li span {
    padding: 4px 10px;
    border-radius: 999px;
    transition: background-color 300ms ease, color 300ms ease;
  }
  .hero-steps li.is-done {
    color: var(--text-3);
  }
  .hero-steps li.is-current span {
    color: var(--text);
    background: rgba(255, 255, 255, 0.08);
  }
  .hero-replay {
    position: absolute;
    right: 0;
    bottom: -6px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    border: 0;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-3);
    font-size: 12px;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms ease, background-color var(--t-hover) ease, color var(--t-hover) ease;
  }
  .hero-replay svg {
    width: 14px;
  }
  .hero-replay.is-shown {
    opacity: 1;
    pointer-events: auto;
  }
  .hero-replay:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.1);
  }

  /* Phone and narrow tablets: the same film, flat and stacked. */
  @media (max-width: 760px) {
    .hero {
      min-height: auto;
      padding: calc(var(--nav-h) + 28px) 0 64px;
    }
    .hero-copy {
      position: relative;
      top: 0;
    }
    .hero-stage-wrap {
      position: relative;
      left: auto;
      top: auto;
      width: auto;
      margin: 36px var(--gutter) 0;
      transform: none;
    }
    .hero-program {
      position: relative;
      right: auto;
      top: auto;
      margin: -18px auto 0;
      width: max-content;
      max-width: 100%;
      transform: none !important;
    }
    .hero-program :global(.pstack) {
      --pb-h: 34px;
      font-size: 12.5px;
    }
    .hw-timeline {
      display: none;
    }
    .hero-steps {
      flex-wrap: wrap;
    }
    .hero-steps li + li::before {
      width: 10px;
    }
    .hero-replay {
      position: static;
      margin: 14px auto 0;
      display: flex;
    }
    .hero-wallpaper {
      inset: -4%;
    }
  }
</style>

<script>
  import { initHero } from './hero';
  const el = document.querySelector<HTMLElement>('[data-hero]');
  if (el) initHero(el);
</script>
