---
/**
 * PROGRAMMABLE VIDEO — the differentiator. The vocabulary as spatial blocks,
 * the signature playground, and the deeper language (logic, Behaviours,
 * scenes), with what's planned marked as planned.
 */
import Playground from './Playground.astro';
import { block, slot, notationHTML } from '../../lib/program/blocks';

const triggers = [
  ['Click', 'Primary Button'],
  ['Hover', 'Search'],
  ['Scroll', 'Down'],
  ['Key Press', 'Return'],
  ['Text Input', 'Any field'],
  ['Time', '0:00'],
];
const actions = [
  ['camera', 'Focus', 'Primary Button'],
  ['effects', 'Highlight', 'Primary Button'],
  ['control', 'Wait', '0.3'],
  ['camera', 'Zoom Out', ''],
  ['effects', 'Play', 'Click Ripple'],
  ['camera', 'Reset', ''],
] as const;

const deeper = [
  {
    title: 'Conditions',
    body: 'One Program can tell clicks apart: IF the target matches, do one thing, ELSE another.',
    src: `WHEN Click [Any button]\nIF Target matches [Primary Button]\n  Focus [Primary Button]\nELSE\n  Reset\nEND`,
  },
  {
    title: 'Parallel',
    body: 'Start several things at the same moment, then carry on when every branch has finished.',
    src: `WHEN Click [Save]\nPARALLEL\n  Focus [Save]\nBRANCH\n  Play Sound\nEND\nReset`,
  },
  {
    title: 'Variables',
    body: 'Count, remember and compare. Later events see what earlier ones changed.',
    src: `WHEN Click [Next]\nChange [clicks] by [1]\nIF [clicks] = [3]\n  Highlight [Next]\nEND`,
  },
  {
    title: 'Behaviours',
    body: 'Turn a run of blocks into a reusable Behaviour with parameters. Edit it once; every Program follows.',
    src: `WHEN Click [Search]\nRun [Emphasise] Target [Search]`,
  },
  {
    title: 'Scenes and shots',
    body: 'Scenes from the Timeline get ENTER and EXIT blocks, shots that start on an event, and Cut or Fade transitions.',
    src: `WHEN [Demo] starts\nFocus [Sign In]\nWait [1.2] seconds\nWHEN [Demo] ends`,
  },
  {
    title: 'Ask',
    body: 'Describe what should happen in plain words. The proposal is checked against the recording and shown as blocks before anything changes.',
    src: `WHEN Click [Create Project]\nFocus [Create Project]\nHighlight [Create Project]`,
    ai: '“Make the camera follow every button click”',
  },
];
---

<section class="section prog" id="program" aria-labelledby="prog-title">
  <div class="prog-bg" aria-hidden="true"></div>
  <div class="container-wide">
    <div class="section-head center">
      <p class="eyebrow" data-reveal><span class="dot"></span>Programmable video</p>
      <h2 id="prog-title" data-reveal data-reveal-delay="80">Your video can respond to what happens inside it.</h2>
      <p class="lead" data-reveal data-reveal-delay="160">A Program says <em>when</em> something happens in the recording and <em>what the video should do</em> about it. It runs on every matching moment, and compiles to camera moves and effects you can still edit by hand.</p>
    </div>

    <div class="vocab" data-reveal="scale">
      <div class="vocab-col">
        <h3 class="vocab-h">When…</h3>
        <div class="vocab-blocks">
          {triggers.map(([e, v], i) => <div class="vb" style={`--i:${i}`} data-tilt><Fragment set:html={block('events', `<b>When</b> ${slot(e)} ${slot(v)}`, { hat: true })} /></div>)}
        </div>
      </div>
      <div class="vocab-arrow" aria-hidden="true">
        <svg viewBox="0 0 120 24" fill="none"><path d="M2 12h112m0 0-8-8m8 8-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" pathLength="1" class="va-path"></path></svg>
      </div>
      <div class="vocab-col">
        <h3 class="vocab-h">…do this</h3>
        <div class="vocab-blocks">
          {
            actions.map(([c, t, v], i) => (
              <div class="vb" style={`--i:${i}`} data-tilt>
                <Fragment set:html={block(c, `<b>${t}</b>${v ? ' ' + slot(v) : ''}${t === 'Wait' ? ' <i>seconds</i>' : ''}`)} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <p class="vocab-note muted" data-reveal>Every block here works in current development builds of MeCorder. Programs are visual blocks in the app; nothing to type.</p>

    <div class="pg-wrap" data-reveal>
      <div class="pg-intro">
        <h3>Try it. Program this recording.</h3>
        <p class="muted">Pick an element, and the demo builds a Program for it. Then change the trigger, swap blocks, retime the wait. The video is regenerated from your Program every time.</p>
      </div>
      <Playground />
    </div>

    <div class="deeper">
      <div class="section-head">
        <h3 class="deeper-title" data-reveal>A small language for how videos behave.</h3>
        <p class="lead" data-reveal data-reveal-delay="80">Beyond single rules, Programs have the parts you'd expect from a real language, shaped as blocks.</p>
      </div>
      <div class="deeper-grid">
        {
          deeper.map((d, i) => (
            <article class="dcard" data-reveal data-reveal-delay={String((i % 3) * 80)} data-tilt>
              <div class="dcard-blocks">
                {d.ai && <p class="dcard-ask">✦ {d.ai}</p>}
                <Fragment set:html={notationHTML(d.src)} />
              </div>
              <h4>{d.title}</h4>
              <p>{d.body}</p>
            </article>
          ))
        }
      </div>
      <div class="planned" data-reveal>
        <span class="chip chip-planned">Planned</span>
        <p>Loops, an IF directly inside another IF, variables shared across a whole project, and finding elements visually in apps that expose no accessibility information are not built yet.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .prog {
    overflow-x: clip;
  }
  .prog-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 40% at 50% 0%, rgba(139, 124, 255, 0.12), transparent 70%),
      radial-gradient(40% 30% at 15% 60%, rgba(218, 175, 46, 0.05), transparent 70%);
    pointer-events: none;
  }
  .prog .section-head em {
    font-style: normal;
    color: var(--text);
  }
  .vocab {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(16px, 4vw, 56px);
    max-width: 1060px;
    margin: 0 auto;
    perspective: 1200px;
  }
  .vocab-h {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-3);
    margin-bottom: 18px;
    letter-spacing: 0;
  }
  .vocab-blocks {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 12px;
  }
  .vb {
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform 300ms var(--ease-out);
    animation: vb-float 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.8s);
  }
  .vb :global(.pblock) {
    transition: transform var(--t-select) var(--ease-spring), box-shadow var(--t-select) ease;
  }
  .vb:hover :global(.pblock) {
    transform: translateZ(18px) translateY(-3px);
    box-shadow:
      var(--shadow-block),
      0 18px 30px -12px rgba(0, 0, 0, 0.7);
  }
  .vb :global(.pblock::after) {
    display: none;
  }
  @keyframes vb-float {
    50% {
      translate: 0 -4px;
    }
  }
  .vocab-arrow {
    width: 120px;
    color: var(--text-4);
  }
  .va-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1200ms var(--ease-out) 400ms;
  }
  .vocab.is-revealed .va-path {
    stroke-dashoffset: 0;
  }
  .vocab-note {
    text-align: center;
    margin-top: 32px;
    font-size: var(--fs-small);
  }

  .pg-wrap {
    margin-top: clamp(72px, 10vw, 128px);
  }
  .pg-intro {
    max-width: 640px;
    margin: 0 auto 28px;
    text-align: center;
  }
  .pg-intro h3 {
    font-size: var(--fs-h3);
    margin-bottom: 10px;
  }

  .deeper {
    margin-top: clamp(96px, 12vw, 160px);
  }
  .deeper-title {
    font-size: var(--fs-h3);
  }
  .deeper .section-head {
    margin-bottom: 36px;
  }
  .deeper .section-head .lead {
    margin-top: 12px;
  }
  .deeper-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .dcard {
    position: relative;
    padding: 20px 20px 24px;
    border-radius: 16px;
    background: var(--bg-raised);
    box-shadow: 0 0 0 1px var(--border-subtle) inset;
    transform: perspective(900px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition:
      transform 300ms var(--ease-out),
      opacity var(--t-reveal) var(--ease-out),
      box-shadow var(--t-select) ease;
    overflow: hidden;
  }
  .dcard::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(240px circle at var(--glow-x, 50%) var(--glow-y, 0%), rgba(255, 255, 255, 0.05), transparent 70%);
    opacity: 0;
    transition: opacity var(--t-select) ease;
    pointer-events: none;
  }
  .dcard:hover::before {
    opacity: 1;
  }
  .dcard-blocks {
    min-height: 196px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .dcard-blocks :global(.pstack-notation) {
    margin: 0;
    padding: 0;
    background: none;
    box-shadow: none;
    --pb-h: 32px;
    font-size: 12.5px;
  }
  .dcard-blocks :global(.pslot) {
    height: 21px;
    font-size: 12px;
    padding: 0 7px;
  }
  .dcard-ask {
    align-self: flex-start;
    margin-bottom: 12px;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 12px;
    color: #d6d0ff;
    background: var(--accent-soft);
    box-shadow: 0 0 0 1px rgba(139, 124, 255, 0.3) inset;
  }
  .dcard h4 {
    margin-top: 18px;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .dcard p {
    margin-top: 6px;
    font-size: var(--fs-small);
    color: var(--text-3);
  }
  .planned {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 24px;
    padding: 16px 18px;
    border-radius: 12px;
    background: rgba(255, 179, 64, 0.04);
    box-shadow: 0 0 0 1px rgba(255, 179, 64, 0.14) inset;
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  @media (max-width: 900px) {
    .vocab {
      grid-template-columns: 1fr;
    }
    .vocab-arrow {
      transform: rotate(90deg);
      width: 60px;
      margin: 0 auto;
    }
    .deeper-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .deeper-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vb {
      animation: none;
    }
  }
</style>

<script>
  import { initTilt } from '../../lib/animation/parallax';
  document.querySelectorAll<HTMLElement>('.prog [data-tilt]').forEach((el) => initTilt(el, el.classList.contains('vb') ? 10 : 3));
</script>
