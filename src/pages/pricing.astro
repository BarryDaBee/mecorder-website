---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
import { PLANS, TRIAL_DAYS, INCLUDED } from '../lib/pricing';

const faqs = [
  {
    q: 'Is there a free trial?',
    a: `Yes. MeCorder works fully for ${TRIAL_DAYS} days, with no account and no card. After that it keeps working, but exports carry a small “Made with MeCorder” mark until you choose a plan.`,
  },
  {
    q: 'What’s the difference between the plans?',
    a: 'Nothing in the app. Every plan unlocks everything. Monthly and Yearly renew until you cancel; Lifetime is paid once and is yours to keep.',
  },
  {
    q: 'Can I switch plans?',
    a: 'Yes. Start monthly and move to yearly or lifetime whenever you like.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. A plan comes with a licence key you paste into Settings. MeCorder runs on your Mac and your recordings stay there.',
  },
  {
    q: 'What about the AI features?',
    a: 'The built-in offline interpreter is included and needs no network. Free-form requests can use your own Anthropic API key, which you pay Anthropic for directly.',
  },
];
---

<Base title="Pricing" description={`MeCorder pricing: monthly, yearly or a one-off lifetime licence. Try everything free for ${TRIAL_DAYS} days.`}>
  <div class="pr container">
    <header class="pr-head">
      <p class="eyebrow" data-reveal><span class="dot"></span>Pricing</p>
      <h1 data-reveal data-reveal-delay="60">One app. Pay the way that suits you.</h1>
      <p class="lead" data-reveal data-reveal-delay="120">Every plan unlocks all of MeCorder. Try it free for {TRIAL_DAYS} days first, no account and no card.</p>
    </header>

    <div class="pr-grid" data-plans>
      {
        PLANS.map((p, i) => (
          <section class:list={['pr-card', { featured: p.featured }]} data-reveal data-reveal-delay={String(i * 80)} aria-labelledby={`plan-${p.id}`} data-tilt>
            {p.featured && <span class="pr-badge">{p.badge}</span>}
            <h2 id={`plan-${p.id}`}>{p.name}</h2>
            <p class="pr-sub">{p.blurb}</p>
            <p class="pr-price">
              <b>${p.price}</b>
              <span>{p.period}</span>
            </p>
            <p class="pr-note-line">{p.note}</p>
            <a
              href={u('/download')}
              class:list={['btn', 'btn-lg', 'pr-cta', p.featured ? 'btn-primary' : 'btn-ghost-outline']}
              data-plan={p.id}
              data-track="download_click"
              data-track-from={`pricing-${p.id}`}
            >
              Start free trial
            </a>
          </section>
        ))
      }
    </div>

    <section class="pr-included" data-reveal aria-labelledby="inc-h">
      <h2 id="inc-h" class="mono-label">Every plan includes</h2>
      <ul>
        {INCLUDED.map((x) => <li>{x}</li>)}
      </ul>
      <p class="pr-req">{SITE.requirements} · Prices in US dollars. Buying opens with the first public release; nothing is charged from this page yet.</p>
    </section>

    <section class="pr-faq" aria-labelledby="faq-h">
      <h2 id="faq-h" data-split>Questions</h2>
      <div class="faq-list">
        {
          faqs.map((f) => (
            <details class="faq" data-reveal>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  .pr {
    padding-top: calc(var(--nav-h) + clamp(48px, 9vw, 120px));
    padding-bottom: 120px;
    max-width: 1120px;
  }
  .pr-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(48px, 7vw, 80px);
  }
  .pr-head h1 {
    font-size: var(--fs-h1);
    letter-spacing: -0.03em;
    margin: 16px 0 20px;
  }
  .pr-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    align-items: stretch;
    perspective: 1200px;
  }
  .pr-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px 28px 28px;
    border-radius: 20px;
    background: var(--bg-raised);
    box-shadow: 0 0 0 1px var(--border-subtle) inset;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition:
      transform 300ms var(--ease-out),
      opacity var(--t-reveal) var(--ease-out),
      box-shadow var(--t-select) ease;
  }
  .pr-card:hover {
    box-shadow: 0 0 0 1px var(--border-strong) inset;
  }
  .pr-card.featured {
    background:
      radial-gradient(90% 60% at 50% 0%, rgba(139, 124, 255, 0.18), transparent 70%),
      var(--bg-raised);
    box-shadow: 0 0 0 1.5px rgba(139, 124, 255, 0.55) inset, 0 30px 60px -30px var(--accent-glow);
  }
  .pr-badge {
    position: absolute;
    top: 18px;
    right: 18px;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font: 600 11px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pr-card h2 {
    font-size: 1.2rem;
  }
  .pr-sub {
    margin-top: 6px;
    color: var(--text-3);
    font-size: var(--fs-small);
  }
  .pr-price {
    margin: 26px 0 6px;
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--text-3);
  }
  .pr-price b {
    font-size: 3rem;
    color: var(--text);
    letter-spacing: -0.03em;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
  .pr-note-line {
    min-height: 1.6em;
    font-size: 13px;
    color: var(--text-3);
    margin-bottom: 28px;
  }
  .pr-cta {
    margin-top: auto;
    width: 100%;
  }
  .btn-ghost-outline {
    --btn-bg: transparent;
    box-shadow: 0 0 0 1px var(--border-strong) inset;
  }
  .btn-ghost-outline:hover {
    --btn-bg: rgba(255, 255, 255, 0.06);
  }
  .pr-included {
    margin-top: 40px;
    padding: 28px;
    border-radius: 20px;
    box-shadow: 0 0 0 1px var(--border-subtle) inset;
  }
  .pr-included h2 {
    margin-bottom: 18px;
  }
  .pr-included ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 28px;
    color: var(--text-2);
  }
  .pr-included li {
    display: flex;
    gap: 10px;
  }
  .pr-included li::before {
    content: '✓';
    color: var(--success);
  }
  .pr-req {
    margin-top: 22px;
    font-size: 12px;
    color: var(--text-4);
  }
  .pr-faq {
    margin-top: clamp(80px, 10vw, 128px);
    max-width: 720px;
    margin-inline: auto;
  }
  .pr-faq h2 {
    font-size: var(--fs-h3);
    margin-bottom: 20px;
  }
  .faq {
    border-top: 1px solid var(--border-subtle);
  }
  .faq:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }
  .faq summary {
    display: flex;
    justify-content: space-between;
    padding: 18px 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::after {
    content: '+';
    color: var(--text-3);
    transition: transform var(--t-select) var(--ease-out);
  }
  .faq[open] summary::after {
    transform: rotate(45deg);
  }
  .faq p {
    padding-bottom: 18px;
    color: var(--text-2);
  }
  @media (max-width: 900px) {
    .pr-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }
    .pr-card.featured {
      order: -1;
    }
    .pr-included ul {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { track } from '../lib/analytics';
  import { initTilt } from '../lib/animation/parallax';
  document.querySelectorAll<HTMLElement>('[data-plans] [data-tilt]').forEach((el) => initTilt(el, 3));
  document.querySelectorAll<HTMLElement>('[data-plan]').forEach((a) =>
    a.addEventListener('click', () => track('plan_selected', { plan: a.dataset.plan! })),
  );
</script>
