---
import Base from '../layouts/Base.astro';
import { DOWNLOAD, SITE } from '../lib/site';
const available = !!DOWNLOAD.url;
const steps = [
  ['Open the download', 'Drag MeCorder into your Applications folder.'],
  ['Allow Screen Recording', 'macOS asks the first time. Quit and reopen MeCorder after allowing it.'],
  ['Allow Accessibility (recommended)', 'So clicks are recorded as named elements that Programs can target.'],
  ['Record', 'Press Start Recording, or ⇧⌘R. Stop with ⇧⌘2.'],
];
---

<Base title="Download" description="Download MeCorder, the screen recorder and video editor for Mac with programmable video. Requires macOS 14 or later on Apple Silicon.">
  <div class="dl container">
    <section class="dl-hero">
      <div class="dl-icon" data-reveal="scale">
        <img src="/app-icon.png" width="160" height="160" alt="MeCorder app icon" />
      </div>
      <h1 data-reveal data-reveal-delay="80">MeCorder for Mac</h1>
      <p class="lead" data-reveal data-reveal-delay="140">Record once. Program the behaviour. Export a video that feels designed.</p>

      <div class="dl-action" data-reveal data-reveal-delay="200">
        <a
          class="btn btn-primary btn-lg dl-btn"
          href={available ? DOWNLOAD.url! : '#not-yet'}
          data-download
          data-available={String(available)}
          data-track="download_click"
          data-track-from="download-page"
          download={available ? DOWNLOAD.fileName : undefined}
        >
          <span class="dl-label">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M14.1 10.6c0-2 1.6-2.9 1.7-3a3.7 3.7 0 0 0-2.9-1.6c-1.2-.1-2.4.7-3 .7s-1.6-.7-2.6-.7a3.9 3.9 0 0 0-3.3 2c-1.4 2.4-.4 6 1 8 .7 1 1.5 2 2.5 2s1.4-.6 2.6-.6 1.5.6 2.6.6 1.7-1 2.4-2a8 8 0 0 0 1.1-2.2 3.4 3.4 0 0 1-2.1-3.2zM12.2 4.6A3.4 3.4 0 0 0 13 2a3.5 3.5 0 0 0-2.3 1.2 3.2 3.2 0 0 0-.8 2.4 2.9 2.9 0 0 0 2.3-1z"></path></svg>
            Download for macOS
          </span>
          <span class="dl-progress" aria-hidden="true"><i></i></span>
        </a>
        <p class="dl-meta">{SITE.requirements}{DOWNLOAD.version ? ` · Version ${DOWNLOAD.version}` : ''}</p>
        <p class="dl-status" id="not-yet" data-status aria-live="polite">
          {available ? '' : 'The first public build isn’t out yet. It will be signed and notarised by Apple, and this button will download it.'}
        </p>
      </div>
    </section>

    <section class="dl-req" aria-labelledby="req-h">
      <h2 id="req-h" data-reveal>Requirements</h2>
      <dl class="req-grid" data-reveal>
        <div><dt>System</dt><dd>macOS 14 Sonoma or later</dd></div>
        <div><dt>Chip</dt><dd>Apple Silicon (M1 or later)</dd></div>
        <div><dt>Permissions</dt><dd>Screen Recording. Optional: Microphone, Camera, Input Monitoring, Speech Recognition, Accessibility</dd></div>
        <div><dt>Privacy</dt><dd>Recordings never leave your Mac</dd></div>
      </dl>
    </section>

    <section class="dl-steps" aria-labelledby="steps-h">
      <h2 id="steps-h" data-reveal>Getting started</h2>
      <ol>
        {
          steps.map(([t, d], i) => (
            <li data-reveal data-reveal-delay={String(i * 60)}>
              <span class="n">{i + 1}</span>
              <div>
                <b>{t}</b>
                <p>{d}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <a class="link-arrow" href="/docs/getting-started">Read the full Getting Started guide</a>
    </section>
  </div>
</Base>

<style>
  .dl {
    padding-top: calc(var(--nav-h) + clamp(48px, 9vw, 112px));
    padding-bottom: 120px;
    max-width: 920px;
  }
  .dl-hero {
    text-align: center;
  }
  .dl-icon {
    display: inline-block;
    filter: drop-shadow(0 30px 50px rgba(139, 124, 255, 0.35));
  }
  .dl-icon img {
    width: 160px;
    height: 160px;
    animation: icon-float 6s ease-in-out infinite;
  }
  @keyframes icon-float {
    50% {
      transform: translateY(-8px) rotate(-1deg);
    }
  }
  .dl-hero h1 {
    font-size: var(--fs-h1);
    letter-spacing: -0.03em;
    margin-top: 24px;
  }
  .dl-hero .lead {
    margin: 14px auto 0;
    max-width: 520px;
  }
  .dl-action {
    margin-top: 36px;
  }
  .dl-btn {
    position: relative;
    min-width: 260px;
    overflow: hidden;
  }
  .dl-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: transform 400ms var(--ease-out), opacity 300ms ease;
  }
  .dl-progress {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 50%;
    height: 4px;
    margin-top: -2px;
    border-radius: 2px;
    background: rgba(0, 0, 0, 0.12);
    opacity: 0;
    overflow: hidden;
    transition: opacity 300ms ease;
  }
  .dl-progress i {
    display: block;
    height: 100%;
    width: 40%;
    border-radius: 2px;
    background: #111;
  }
  .dl-btn.is-busy .dl-label {
    transform: translateY(-140%);
    opacity: 0;
  }
  .dl-btn.is-busy .dl-progress {
    opacity: 1;
  }
  .dl-btn.is-busy .dl-progress i {
    animation: dl-indeterminate 1s var(--ease-in-out) infinite;
  }
  @keyframes dl-indeterminate {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(250%);
    }
  }
  .dl-meta {
    margin-top: 14px;
    font-size: 13px;
    color: var(--text-3);
  }
  .dl-status {
    max-width: 440px;
    margin: 10px auto 0;
    font-size: 13px;
    color: var(--text-4);
    transition: color 300ms ease;
  }
  .dl-status.is-highlight {
    color: var(--text-2);
  }
  .dl-req,
  .dl-steps {
    margin-top: clamp(72px, 10vw, 112px);
  }
  .dl-req h2,
  .dl-steps h2 {
    font-size: var(--fs-h3);
    margin-bottom: 20px;
  }
  .req-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: var(--border-subtle);
    box-shadow: 0 0 0 1px var(--border-subtle);
  }
  .req-grid div {
    padding: 20px 22px;
    background: var(--bg-raised);
  }
  .req-grid dt {
    font-size: 12px;
    color: var(--text-3);
  }
  .req-grid dd {
    margin: 4px 0 0;
    font-weight: 550;
  }
  .dl-steps ol {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .dl-steps li {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .dl-steps .n {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--surface-2);
    font-size: 13px;
    font-weight: 600;
  }
  .dl-steps p {
    color: var(--text-3);
    font-size: var(--fs-small);
    margin-top: 2px;
  }
  @media (max-width: 640px) {
    .req-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLAnchorElement>('[data-download]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  if (btn && btn.dataset.available !== 'true') {
    // No build to download yet: the button still responds, then says so plainly.
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      if (btn.classList.contains('is-busy')) return;
      btn.classList.add('is-busy');
      setTimeout(() => {
        btn.classList.remove('is-busy');
        status?.classList.add('is-highlight');
        status?.focus?.();
      }, 600);
    });
  }
</script>
