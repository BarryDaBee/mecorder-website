---
import { u } from '../lib/url';
import '../styles/global.css';
import Nav from '../components/navigation/Nav.astro';
import Footer from '../components/footer/Footer.astro';
import Search from '../components/documentation/Search.astro';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of the Open Graph image, relative to the site root. */
  image?: string;
  /** Extra JSON-LD objects for this page. */
  structuredData?: Record<string, unknown>[];
  /** Pages whose top is light-on-dark hero can start with the transparent nav. */
  navMode?: 'transparent' | 'solid';
  bodyClass?: string;
  noFooter?: boolean;
}

const {
  title,
  description = SITE.description,
  image = '/og.png',
  structuredData = [],
  navMode = 'transparent',
  bodyClass = '',
  noFooter = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline.replace(/\.$/, '')}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;
const imageUrl = new URL(u(image), Astro.site).href;

const baseLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link rel="apple-touch-icon" href={u('/icon-256.png')} />
    <link rel="sitemap" href={u('/sitemap.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify([baseLd, ...structuredData])} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav mode={navMode} />
    <main id="main">
      <slot />
    </main>
    {!noFooter && <Footer />}
    <Search />
    <script>
      import { initReveals } from '../lib/animation/reveal';
      import { bindDeclarativeTracking } from '../lib/analytics';
      initReveals();
      bindDeclarativeTracking();
    </script>
  </body>
</html>
